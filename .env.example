# visit https://giscus.app to get your Giscus ids
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPOSITORY_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
NEXT_PUBLIC_UTTERANCES_REPO=
NEXT_PUBLIC_DISQUS_SHORTNAME=

# Cloudflare Images (hosted on imagedelivery.net — keep DNS gray-cloud → Vercel)
# Dashboard → Images → Developer Resources → Account Hash
NEXT_PUBLIC_CF_IMAGES_ACCOUNT_HASH=
# Upload script only (never commit real tokens)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Google Search Console HTML meta (optional override; DNS TXT already live — see docs/google-search-console.md)
# Token only — do not include "google-site-verification="
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

MAILCHIMP_API_KEY=
MAILCHIMP_API_SERVER=
MAILCHIMP_AUDIENCE_ID=

BUTTONDOWN_API_KEY=

CONVERTKIT_API_KEY=
# curl https://api.convertkit.com/v3/forms?api_key=<your_public_api_key> to get your form ID
CONVERTKIT_FORM_ID=

KLAVIYO_API_KEY=
KLAVIYO_LIST_ID=

REVUE_API_KEY=

# Create EmailOctopus API key at https://emailoctopus.com/api-documentation
EMAILOCTOPUS_API_KEY=
# List ID can be found in the URL as a UUID after clicking a list on https://emailoctopus.com/lists
# or the settings page of your list https://emailoctopus.com/lists/{UUID}/settings
EMAILOCTOPUS_LIST_ID=

# Create Beehiiv API key at https://developers.beehiiv.com/docs/v2/bktd9a7mxo67n-create-an-api-key
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# Google Analytics 4 — optional (G-XXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Virtual Twin / Connect hub (DrGeneBoyle.com — not about.me)
# Spotlight = the single most important visitor action
NEXT_PUBLIC_SPOTLIGHT_LABEL=Book a strategy call
# Optional override; defaults to Google Calendar booking URL when set
NEXT_PUBLIC_SPOTLIGHT_HREF=
# Google Calendar appointment schedule embed URL
NEXT_PUBLIC_GOOGLE_CALENDAR_BOOKING_URL=
# Optional YouTube/Vimeo embed for /connect video section
NEXT_PUBLIC_INTRO_VIDEO_EMBED_URL=

# Lead capture → CRM webhook and/or Resend email
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=
LEADS_WEBHOOK_URL=
LEADS_NOTIFY_EMAIL=info@drgeneboyle.com
LEADS_FROM_EMAIL=leads@drgeneboyle.com
RESEND_API_KEY=

# Optional OpenAI fallback when twin knowledge base misses
OPENAI_API_KEY=
OPENAI_TWIN_MODEL=gpt-4o-mini
