{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "drgeneboyle.com" }],
      "destination": "https://www.drgeneboyle.com/:path*",
      "permanent": true
    },
    {
      "source": "/projects",
      "destination": "/publications",
      "permanent": true
    },
    {
      "source": "/projects/",
      "destination": "/publications",
      "permanent": true
    }
  ]
}
